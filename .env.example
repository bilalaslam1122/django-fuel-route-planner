# Copy to .env and adjust. Never put real secrets in .env.example.

# --- Django ---
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- External map services (OpenStreetMap ecosystem; no API key needed) ---
GEOCODING_API_URL=https://nominatim.openstreetmap.org
ROUTING_API_URL=https://router.project-osrm.org
# Nominatim's usage policy requires an identifying User-Agent (ideally with contact info).
EXTERNAL_API_USER_AGENT=fuel-route-planner/1.0 (take-home assessment)
EXTERNAL_API_TIMEOUT_SECONDS=10

# --- Data files (defaults shown) ---
# FUEL_DATA_CSV=data/fuel-prices-for-be-assessment.csv
# CITY_COORDINATES_CSV=data/city_coordinates.csv
